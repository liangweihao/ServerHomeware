{"name": "sqlalchemy.engine.Engine", "message": "\nCREATE TABLE notifications (\n\tfamily_id INTEGER NOT NULL, \n\tuser_id INTEGER, \n\ttype VARCHAR(30) NOT NULL, \n\ttitle VARCHAR(100) NOT NULL, \n\tbody VARCHAR(500), \n\titem_id INTEGER, \n\tpriority VARCHAR(10), \n\tis_read BOOLEAN, \n\taction_url VARCHAR(200), \n\tid INTEGER NOT NULL, \n\tcreated_at DATETIME, \n\tupdated_at DATETIME, \n\tPRIMARY KEY (id), \n\tFOREIGN KEY(family_id) REFERENCES families (id), \n\tFOREIGN KEY(user_id) REFERENCES users (id)\n)\n\n", "taskName": "Task-2", "timestamp": "2026-05-22 18:47:56,539", "level": "INFO"}
