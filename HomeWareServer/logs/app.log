{"name": "sqlalchemy.engine.Engine", "message": "\nCREATE TABLE notification_preferences (\n\tuser_id INTEGER NOT NULL, \n\tpush_enabled BOOLEAN, \n\texpiry_alert BOOLEAN, \n\tstock_alert BOOLEAN, \n\tpurchase_alert BOOLEAN, \n\twarranty_alert BOOLEAN, \n\tquiet_start TIME, \n\tquiet_end TIME, \n\tPRIMARY KEY (user_id), \n\tFOREIGN KEY(user_id) REFERENCES users (id)\n)\n\n", "taskName": "Task-2", "timestamp": "2026-05-22 18:47:56,538", "level": "INFO"}
