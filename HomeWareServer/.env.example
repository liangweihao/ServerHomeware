# App
APP_NAME=HomeStock
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1
VERSION=1.0.0

# Database
# 本地/轻量部署（默认 SQLite，数据在项目外 data/ 目录）：
DATABASE_URL=sqlite+aiosqlite:///../data/homestock.db
# Docker / PostgreSQL 示例：
# DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/homestock

# Redis（本机 redis://127.0.0.1:6379/0；Docker 用 redis://redis:6379/0）
REDIS_URL=redis://127.0.0.1:6379/0

# JWT（生产务必改为强随机字符串，至少 32 字符）
JWT_SECRET_KEY=your-secret-key-change-in-production-must-be-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# File Upload
UPLOAD_DIR=../data/uploads
MAX_FILE_SIZE_MB=10

# Image Processing
MAX_IMAGE_WIDTH=720
IMAGE_QUALITY=75

# Rate Limit
RATE_LIMIT_STORAGE_URL=redis://127.0.0.1:6379/1
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/hour
DEFAULT_RATE_LIMIT=60/minute
UPLOAD_RATE_LIMIT=20/minute

# CORS（逗号分隔，或 *）
CORS_ORIGINS=*

# FCM (Firebase Cloud Messaging)
FCM_SERVER_KEY=

# DeepSeek AI 助手（在 platform.deepseek.com 注册后获取）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
