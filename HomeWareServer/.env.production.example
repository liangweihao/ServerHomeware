DEBUG=false
LOG_LEVEL=WARNING
APP_NAME=HomeStock
APP_ENV=production
VERSION=1.0.0
API_PREFIX=/api/v1

# Database（默认 SQLite，无需额外安装 PostgreSQL；Docker 部署可改为 postgres）
DATABASE_URL=sqlite+aiosqlite:///./homestock_prod.db

# Redis（非 Docker 直连本机 Redis 时用 redis://127.0.0.1:6379/0）
REDIS_URL=redis://127.0.0.1:6379/0

# JWT（生产环境务必修改为强随机字符串，至少 32 字符）
JWT_SECRET_KEY=your_strong_production_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Image Processing
MAX_IMAGE_WIDTH=1080
IMAGE_QUALITY=85

# Rate Limit
RATE_LIMIT_STORAGE_URL=redis://127.0.0.1:6379/1
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/hour
DEFAULT_RATE_LIMIT=60/minute
UPLOAD_RATE_LIMIT=20/minute

# CORS
CORS_ORIGINS=https://your-domain.com

# FCM
FCM_SERVER_KEY=

# DeepSeek AI 助手（在 platform.deepseek.com 注册后获取）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
