# App
APP_NAME=HomeStock
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Database（开发环境 SQLite，数据存在项目外 data/ 目录，方便备份）
DATABASE_URL=sqlite+aiosqlite:///../data/homestock.db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production-must-be-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# File Upload（图片存在项目外 data/uploads/，方便备份）
UPLOAD_DIR=../data/uploads
MAX_FILE_SIZE_MB=10

# FCM (Firebase Cloud Messaging)
FCM_SERVER_KEY=your-fcm-key