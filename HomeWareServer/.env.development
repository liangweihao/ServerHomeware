DEBUG=true
LOG_LEVEL=DEBUG
APP_NAME=HomeStock Dev
APP_ENV=development
VERSION=1.0.0
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/homestock

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=dev_secret_key_change_in_production_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# File Upload
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10

# Image Processing
MAX_IMAGE_WIDTH=1080
IMAGE_QUALITY=85

# Rate Limit
RATE_LIMIT_STORAGE_URL=redis://redis:6379/1
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/hour
DEFAULT_RATE_LIMIT=60/minute
UPLOAD_RATE_LIMIT=20/minute

# CORS
CORS_ORIGINS=["*"]

# FCM
FCM_SERVER_KEY=
