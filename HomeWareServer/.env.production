DEBUG=false
LOG_LEVEL=WARNING
APP_NAME=HomeStock
APP_ENV=production
VERSION=1.0.0
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/homestock

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=your_strong_production_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# File Upload
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10

# Image Processing
MAX_IMAGE_WIDTH=1080
IMAGE_QUALITY=85

# Rate Limit
RATE_LIMIT_STORAGE_URL=redis://redis:6379/1
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/hour
DEFAULT_RATE_LIMIT=60/minute
UPLOAD_RATE_LIMIT=20/minute

# CORS
CORS_ORIGINS=["https://your-domain.com"]

# FCM
FCM_SERVER_KEY=
